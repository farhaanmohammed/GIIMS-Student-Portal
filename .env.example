# GIIMS Student Portal - Environment Configuration
# Copy this file to .env for local development

# Django Security
DJANGO_SECRET_KEY=giims-local-dev-secret-key-change-in-production-2026-portal
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production HTTPS / Cookie Hardening (defaults to enabled when DJANGO_DEBUG=False)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_USE_X_FORWARDED_PROTO=True

# PostgreSQL Database
DB_NAME=giims_db
DB_USER=giims_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Localization & Email
TIME_ZONE=Asia/Kolkata
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
