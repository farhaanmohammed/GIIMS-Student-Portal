# GIIMS Student Portal - Environment Configuration
# Copy this file to .env for local development

# Django Security
DJANGO_SECRET_KEY=giims-local-dev-secret-key-change-in-production-2026-portal
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL Database
DB_NAME=giims_db
DB_USER=giims_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Localization
TIME_ZONE=Asia/Kolkata
